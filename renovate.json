{
    "extends": [
        "config:best-practices",
        ":disableDependencyDashboard",
        ":preserveSemverRanges",
        "schedule:weekly",
        "group:allNonMajor",
        "github>maestra-io/renovate-config:externalImages"
    ],
    "ignorePaths": [
        "**/node_modules/**",
        "**/bower_components/**",
        "**/vendor/**",
        "**/examples/**",
        "**/__tests__/**",
        "**/test/**",
        "**/__fixtures__/**"
    ],
    "minimumReleaseAge": "14 days",
    "rebaseWhen": "conflicted",
    "separateMajorMinor": true,
    "packageRules": [
        {
            "description": "Group all non-major updates into a single PR",
            "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
            "groupName": "all non-major dependencies"
        },
        {
            "description": "Major updates get individual PRs for careful review",
            "matchUpdateTypes": ["major"],
            "groupName": null
        },
        {
            "description": "Group Docker digest updates. No automerge: an external digest move is new content (issues-maestra#1649)",
            "matchDatasources": ["docker"],
            "matchUpdateTypes": ["digest"],
            "groupName": "docker digest updates"
        },
        {
            "description": "Automerge patch-level updates",
            "matchUpdateTypes": ["patch", "pin"],
            "minimumReleaseAge": "14 days",
            "automerge": true
        },
        {
            "description": "grafana-legacy (11) and grafana-legacy-8 (8.5) in docker-compose.yaml pin old majors on purpose to exercise the legacy API fallbacks. Only the main grafana service tracks new majors.",
            "matchDatasources": ["docker"],
            "matchPackageNames": ["grafana/grafana"],
            "matchCurrentVersion": "<12.0.0",
            "matchUpdateTypes": ["major"],
            "enabled": false
        },
        {
            "description": "Bump the go directive in the root go.mod, which Renovate skips by default. lokiguard keeps its own consumer minimum.",
            "matchManagers": ["gomod"],
            "matchFileNames": ["go.mod"],
            "matchDepNames": ["go"],
            "matchDepTypes": ["golang"],
            "rangeStrategy": "bump"
        },
        {
            "description": "Bump Go everywhere in one PR: the go.mod directive, mise.toml, and the Dockerfile builder images.",
            "matchDepNames": ["go", "golang"],
            "groupName": "go"
        },
        {
            "description": "Patch only for Go in go.mod and mise.toml. A minor in go.mod raises the minimum Go for module consumers. mise.toml builds the release binaries, which stay on 1.26 until golang/go#81199 is fixed (see mise.toml).",
            "matchManagers": ["gomod", "mise"],
            "matchDepNames": ["go"],
            "matchUpdateTypes": ["major", "minor"],
            "enabled": false
        }
    ]
}
